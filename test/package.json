{
  "name": "kawaii-jlpt",
  "version": "3.8.0",
  "private": true,
  "description": "Local-first JLPT learning app. Serve app/ over HTTP(S); no application build required.",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node tests/browser-smoke.cjs",
    "test:zen": "ZEN_REAL=1 node tests/browser-smoke.cjs",
    "check": "node tools/check-syntax.cjs",
    "build:css": "tailwindcss -c tailwind.config.cjs -i tools/tailwind-input.css -o tailwind.css --minify",
    "build:offline": "node tools/build-offline.cjs"
  },
  "devDependencies": {"playwright":"1.62.1", "tailwindcss":"3.4.17"}
}
